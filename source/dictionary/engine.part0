(() => {
  'use strict';

  if (window.WarextTurkishSpellEngineV142) return;

  const TDK_TEXT = __TDK_JSON__;
  const EXTRA_VALID_TEXT = __EXTRA_JSON__;
  const COMMON = {"dah":["dağ","daha","dahi"],"saol":["sağ ol"],"sagol":["sağ ol"],"sağol":["sağ ol"],"saolun":["sağ olun"],"sagolun":["sağ olun"],"sağolun":["sağ olun"],"patate":["patates"],"merhab":["merhaba"],"tmm":["tamam"],"yanlız":["yalnız"],"yalnış":["yanlış"],"herkez":["herkes"],"şarz":["şarj"],"klavuz":["kılavuz"],"traş":["tıraş"],"eşortman":["eşofman"],"şöför":["şoför"],"süpriz":["sürpriz"],"antreman":["antrenman"],"orjinal":["orijinal"],"malesef":["maalesef"],"müsade":["müsaade"],"deyil":["değil"],"kirbit":["kibrit"],"anfi":["amfi"],"herşey":["her şey"],"birşey":["bir şey"],"bişey":["bir şey"],"hiçbirşey":["hiçbir şey"],"hiçbişey":["hiçbir şey"],"pekçok":["pek çok"],"yada":["ya da"],"şuan":["şu an"],"hoşgeldin":["hoş geldin"],"hoşbulduk":["hoş bulduk"],"peşpeşe":["peş peşe"],"ardarda":["art arda"],"denmee":["deneme"],"dejeme":["deneme"],"tabiki":["tabii ki"],"iyiki":["iyi ki"],"demekki":["demek ki"],"belkide":["belki de"],"naber":["ne haber"],"napıyorsun":["ne yapıyorsun"],"napıyon":["ne yapıyorsun"],"noldu":["ne oldu"],"gelicem":["geleceğim"],"gidicem":["gideceğim"],"yapıcam":["yapacağım"],"yapcam":["yapacağım"],"ediyom":["ediyorum"],"geliyom":["geliyorum"],"gidiyom":["gidiyorum"],"çünki":["çünkü"],"yanlızlık":["yalnızlık"],"yanlızca":["yalnızca"]};

  const INTENT_FORMS = [
    'nasılsın','nasılsınız','nasılım','iyisin','iyiyim','iyiyiz','iyisiniz',
    'merhaba','görüşürüz','teşekkürler','teşekkür','tamam','tamamdır',
    'geleceğim','gideceğim','yapacağım','olacağım','istiyorum','istemiyorum',
    'biliyorum','bilmiyorum','anlıyorum','anlamadım','dünyanın','bugün','yarın',
    'şimdi','çünkü','değil','mısın','misin','musun','müsün','mısınız','misiniz',
    'musunuz','müsünüz','oluyor','olmuyor','geliyor','gidiyor','yapıyor'
  ];

  const TURKISH_CHAR_ALTS = {
    'i': ['ı'],
    'g': ['ğ'],
    's': ['ş'],
    'c': ['ç'],
    'o': ['ö'],
    'u': ['ü']
  };
  const TURKISH_EQUIVALENT_PAIRS = new Set(['iı','ıi','gğ','ğg','sş','şs','cç','çc','oö','öo','uü','üu']);

  const normalize = value => String(value || '')
    .replace(/I/g, 'ı')
    .replace(/İ/g, 'i')
    .toLocaleLowerCase('tr-TR')
    .trim();

  const chars = value => Array.from(value);
  const tdkWords = TDK_TEXT ? TDK_TEXT.split('\n') : [];
  const extraValid = EXTRA_VALID_TEXT ? EXTRA_VALID_TEXT.split('\n') : [];
  const valid = new Set(tdkWords);
  for (const word of extraValid) valid.add(word);

  for (const word of ['xenforo','minecraft','discord','warext','mc-tr','php','javascript','css','html'])
    valid.add(word);

  const byFirstLength = new Map();
  const byLength = new Map();
  const lengthOf = word => chars(word).length;
  for (const word of tdkWords) {
    const c = chars(word);
    if (!c.length) continue;
    const len = c.length;
    const key = `${c[0]}:${len}`;
    if (!byFirstLength.has(key)) byFirstLength.set(key, []);
    byFirstLength.get(key).push(word);
    if (!byLength.has(len)) byLength.set(len, []);
    byLength.get(len).push(word);
  }

  const SUFFIXES = [
    'lerimizden','larımızdan','lerinizden','larınızdan','lerimiz','larımız','leriniz','larınız',
    'umuzdan','ümüzden','ımızdan','imizden','unuzdan','ünüzden','ınızdan','inizden',
    'umuzda','ümüzde','ımızda','imizde','unuzda','ünüzde','ınızda','inizde',
    'umuz','ümüz','ımız','imiz','unuz','ünüz','ınız','iniz',
    'ları','leri','lar','ler','dan','den','tan','ten','dır','dir','dur','dür','tır','tir','tur','tür',
    'lık','lik','luk','lük','cı','ci','cu','cü','çı','çi','çu','çü','sız','siz','suz','süz',
    'ım','im','um','üm','ın','in','un','ün','da','de','ta','te','ya','ye','yı','yi','yu','yü',
    'la','le','lı','li','lu','lü'
  ].sort((a,b) => chars(b).length - chars(a).length);

  function isLikelyInflected(word) {
    if (COMMON[word]) return false;
    const seen = new Set([word]);
    let frontier = [word];
    for (let depth = 0; depth < 3; depth++) {
      const next = [];
      for (const form of frontier) {
        for (const suffix of SUFFIXES) {
          if (!form.endsWith(suffix)) continue;
          const stem = form.slice(0, -suffix.length);
          if (chars(stem).length < 3 || seen.has(stem)) continue;
          if (COMMON[stem]) continue;
          if (valid.has(stem)) return true;
          seen.add(stem);
          next.push(stem);
        }
      }
      frontier = next;
      if (!frontier.length) break;
    }
    return false;
  }

  function damerau(a, b, maxDistance = 3) {
    const A = chars(a), B = chars(b);
    const n = A.length, m = B.length;
    if (Math.abs(n - m) > maxDistance) return maxDistance + 1;
    let prev2 = null;
    let prev = Array.from({ length: m + 1 }, (_, i) => i);
    for (let i = 1; i <= n; i++) {
      const cur = [i];
      let rowMin = cur[0];
      for (let j = 1; j <= m; j++) {
        const cost = A[i - 1] === B[j - 1] ? 0 : 1;
        let v = Math.min(
          cur[j - 1] + 1,
          prev[j] + 1,
          prev[j - 1] + cost
        );
        if (prev2 && i > 1 && j > 1 && A[i - 1] === B[j - 2] && A[i - 2] === B[j - 1])
          v = Math.min(v, prev2[j - 2] + 1);
        cur[j] = v;
        if (v < rowMin) rowMin = v;
      }
      if (rowMin > maxDistance) return maxDistance + 1;
      prev2 = prev;
      prev = cur;
    }
    return prev[m];
  }

  function commonPrefix(a, b) {
    const A = chars(a), B = chars(b);
    let i = 0;
    while (i < A.length && i < B.length && A[i] === B[i]) i++;
    return i;
  }

  function orthographicValidVariants(word, limit = 8) {
    const source = chars(word);
    const positions = [];
    for (let i = 0; i < source.length; i++) {
      const alts = TURKISH_CHAR_ALTS[source[i]];
      if (alts?.length) positions.push([i, alts]);
    }

    const exact = [];
    const intent = [];
    const morphological = [];
    const seen = new Set();
    const intentSet = new Set(INTENT_FORMS);
    const pushIfValid = candidateChars => {
      const candidate = candidateChars.join('');
      if (candidate === word || seen.has(candidate)) return;
      seen.add(candidate);
      if (valid.has(candidate)) exact.push(candidate);
      else if (intentSet.has(candidate) && isLikelyInflected(candidate)) intent.push(candidate);
      else if (isLikelyInflected(candidate)) morphological.push(candidate);
    };

    for (const [index, alts] of positions) {
      for (const alt of alts) {
        const copy = source.slice();
        copy[index] = alt;
        pushIfValid(copy);
      }
    }

    if (source.length <= 16 && positions.length <= 10) {
      for (let a = 0; a < positions.length; a++) {
        for (let b = a + 1; b < positions.length; b++) {
          const [ia, aa] = positions[a];
          const [ib, ab] = positions[b];
          for (const va of aa) for (const vb of ab) {
            const copy = source.slice();
            copy[ia] = va;
            copy[ib] = vb;
            pushIfValid(copy);
          }
        }
      }
    }

    return [...exact, ...intent, ...morphological].slice(0, limit);
  }

  function substitutionCost(a, b) {
    if (a === b) return 0;
    if (TURKISH_EQUIVALENT_PAIRS.has(`${a}${b}`)) return 0.28;
    const pair = `${a}${b}`;
    if (['gs','sg','ğs','sğ','lk','kl','nm','mn','io','oi','ıi','iı'].includes(pair)) return 0.78;
    return 1;
  }

  function weightedDistance(a, b, maxDistance = 2.6) {
    const A = chars(a), B = chars(b);
    if (Math.abs(A.length - B.length) > 2) return maxDistance + 1;
    let prev2 = null;
    let prev = Array.from({length: B.length + 1}, (_, i) => i);
    for (let i = 1; i <= A.length; i++) {
      const cur = [i];
      let rowMin = cur[0];
      for (let j = 1; j <= B.length; j++) {
        const sub = substitutionCost(A[i - 1], B[j - 1]);
        let value = Math.min(cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + sub);
        if (prev2 && i > 1 && j > 1 && A[i - 1] === B[j - 2] && A[i - 2] === B[j - 1]) {
          value = Math.min(value, prev2[j - 2] + 0.85);
        }
        cur[j] = value;
        if (value < rowMin) rowMin = value;
      }
      if (rowMin > maxDistance + 0.75) return maxDistance + 1;
      prev2 = prev;
      prev = cur;
    }
    return prev[B.length];
  }

  function intentSuggestions(word, limit = 3) {
    const scored = [];
    const len = chars(word).length;
    const threshold = len <= 4 ? 1.35 : (len <= 7 ? 2.15 : 2.6);
    for (const candidate of INTENT_FORMS) {
      if (candidate === word) continue;
      if (Math.abs(chars(candidate).length - len) > 2) continue;
      const distance = weightedDistance(word, candidate, threshold);
      if (distance > threshold) continue;
      const prefix = commonPrefix(word, candidate);
      const score = distance * 100 - prefix * 7 + Math.abs(chars(candidate).length - len) * 5;
      scored.push([score, candidate]);
    }
    scored.sort((a,b) => a[0] - b[0] || a[1].localeCompare(b[1], 'tr'));
    return scored.slice(0, limit).map(item => item[1]);
  }

  function findSuggestions(word, limit = 3, preferred = []) {
    const result = [];
    const seen = new Set();
    for (const item of preferred) {
      const normalizedItem = normalize(item);
      if (!normalizedItem 