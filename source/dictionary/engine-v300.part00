(() => {
  'use strict';

  if (window.WarextTurkishSpellEngineV300) return;

  const TDK_TEXT = __TDK_JSON__;
  const EXTRA_VALID_TEXT = __EXTRA_JSON__;
  const COMMON = {"dah":["dağ","daha","dahi"],"saol":["sağ ol"],"sagol":["sağ ol"],"sağol":["sağ ol"],"saolun":["sağ olun"],"sagolun":["sağ olun"],"sağolun":["sağ olun"],"patate":["patates"],"merhab":["merhaba"],"tmm":["tamam"],"yanlız":["yalnız"],"yalnış":["yanlış"],"herkez":["herkes"],"şarz":["şarj"],"klavuz":["kılavuz"],"traş":["tıraş"],"eşortman":["eşofman"],"şöför":["şoför"],"süpriz":["sürpriz"],"antreman":["antrenman"],"orjinal":["orijinal"],"malesef":["maalesef"],"müsade":["müsaade"],"deyil":["değil"],"kirbit":["kibrit"],"anfi":["amfi"],"herşey":["her şey"],"birşey":["bir şey"],"bişey":["bir şey"],"hiçbirşey":["hiçbir şey"],"hiçbişey":["hiçbir şey"],"pekçok":["pek çok"],"yada":["ya da"],"şuan":["şu an"],"hoşgeldin":["hoş geldin"],"hoşbulduk":["hoş bulduk"],"peşpeşe":["peş peşe"],"ardarda":["art arda"],"denmee":["deneme"],"dejeme":["deneme"],"tabiki":["tabii ki"],"iyiki":["iyi ki"],"demekki":["demek ki"],"belkide":["belki de"],"naber":["ne haber"],"napıyorsun":["ne yapıyorsun"],"napıyon":["ne yapıyorsun"],"noldu":["ne oldu"],"gelicem":["geleceğim"],"gidicem":["gideceğim"],"yapıcam":["yapacağım"],"yapcam":["yapacağım"],"ediyom":["ediyorum"],"geliyom":["geliyorum"],"gidiyom":["gidiyorum"],"çünki":["çünkü"],"yanlızlık":["yalnızlık"],"yanlızca":["yalnızca"],"yanısıra":["yanı sıra"],"birarada":["bir arada"],"gözardı":["göz ardı"],"haketmek":["hak etmek"],"farketmek":["fark etmek"],"terketmek":["terk etmek"],"varolmak":["var olmak"],"yokolmak":["yok olmak"],"hiçkimse":["hiç kimse"],"herhangibir":["herhangi bir"],"bugünki":["bugünkü"],"şimdikiğ":["şimdiki"],"önplanda":["ön planda"],"önplana":["ön plana"],"benimde":["benim de"],"seninde":["senin de"],"bizimde":["bizim de"],"sizinde":["sizin de"],"onunda":["onun da"],"bununda":["bunun da"],"şununda":["şunun da"],"biliyorumki":["biliyorum ki"],"görüyorumki":["görüyorum ki"],"sanıyorumki":["sanıyorum ki"],"anladımki":["anladım ki"],"başbaşa":["baş başa"],"baştanbaşa":["başтан başa"],"içiçe":["iç içe"],"yanyana":["yan yana"],"üstüste":["üst üste"],"artarda":["art arda"],"geliyormusun":["geliyor musun"],"gidiyormusun":["gidiyor musun"],"yapıyormusun":["yapıyor musun"],"gelecekmisin":["gelecek misin"],"geldinmi":["geldin mi"],"gittinmi":["gittin mi"],"yaptınmı":["yaptın mı"],"biliyormusun":["biliyor musun"],"anladınmı":["anladın mı"],"tamammı":["tamam mı"],"değilmi":["değil mi"],"varmı":["var mı"],"yokmu":["yok mu"],"farketmiş":["fark etmiş"],"farketmişim":["fark etmişim"],"haketmiş":["hak etmiş"],"terketti":["terk etti"],"yoketti":["yok etti"],"varoldu":["var oldu"],"birçokkez":["birçok kez"],"herdefasında":["her defasında"],"pekaz":["pek az"]};


  const INTENT_FORMS = [
    'nasılsın','nasılsınız','nasılım','iyisin','iyiyim','iyiyiz','iyisiniz',
    'merhaba','görüşürüz','teşekkürler','teşekkür','tamam','tamamdır',
