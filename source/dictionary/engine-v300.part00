    'şimdi','çünkü','değil','mısın','misin','musun','müsün','mısınız','misiniz',
    'musunuz','müsünüz','oluyor','olmuyor','geliyor','gidiyor','yapıyor'
  ];

  const FINAL_COMMON_ERRORS = {
    'acenta':['acente'],'akibet':['akıbet'],'antreman':['antrenman'],'ardarda':['art arda'],'artarda':['art arda'],
    'asvalt':['asfalt'],'ayrıyetten':['ayrıca'],'birarada':['bir arada'],'birkez':['bir kez'],'birşey':['bir şey'],
    'bugünki':['bugünkü'],'cünki':['çünkü'],'çünki':['çünkü'],'değermi':['değer mi'],'döküman':['doküman'],
    'egsoz':['egzoz'],'eksoz':['egzoz'],'eşortman':['eşofman'],'farketmek':['fark etmek'],'farketmiyor':['fark etmiyor'],
    'herbir':['her bir'],'herkez':['herkes'],'herşey':['her şey'],'hiçkimse':['hiç kimse'],'hoşgeldin':['hoş geldin'],
    'hoşgeldiniz':['hoş geldiniz'],'iddaa':['iddia'],'insiyatif':['inisiyatif'],'karnıbahar':['karnabahar'],'klavuz':['kılavuz'],
    'labaratuvar':['laboratuvar'],'malesef':['maalesef'],'meyva':['meyve'],'müsayit':['müsait'],'orjinal':['orijinal'],
    'pekçok':['pek çok'],'poaça':['poğaça'],'rasgele':['rastgele'],'seyehat':['seyahat'],'şarz':['şarj'],
    'şöför':['şoför'],'traş':['tıraş'],'yanlız':['yalnız'],'yalnış':['yanlış'],'yanısıra':['yanı sıra'],
    'yinede':['yine de'],'zerafet':['zarafet']
  };
  Object.assign(COMMON, FINAL_COMMON_ERRORS);

  const TURKISH_CHAR_ALTS = {
    'i': ['ı'], 'ı': ['i'],
    'g': ['ğ'], 'ğ': ['g'],
    's': ['ş'], 'ş': ['s'],
    'c': ['ç'], 'ç': ['c'],
    'o': ['ö'], 'ö': ['o'],
    'u': ['ü'], 'ü': ['u']
  };
  const TURKISH_EQUIVALENT_PAIRS = new Set(['iı','ıi','gğ','ğg','sş','şs','cç','çc','oö','öo','uü','üu']);

  const normalize = value => String(value || '')
    .replace(/I/g, 'ı')
    .replace(/İ/g, 'i')
    .toLocaleLowerCase('tr-TR')
    .trim();

  const chars = value => Array.from(value);
  const tdkWords = TDK_TEXT ? TDK_TEXT.split('\n') : [];
  const extraValid = EXTRA_VALID_TEXT ? EXTRA_VALID_TEXT.split('\n') : [];
  const tdkSet = new Set(tdkWords);
  const valid = new Set(tdkWords);
  for (const word of extraValid) valid.add(word);

  const customWords = new Set();

  function setCustomWords(words) {
    customWords.clear();
    if (Array.isArray(words) || words instanceof Set) {
      for (const raw of words) {
        const word = normalize(raw);
        if (word && chars(word).length >= 2 && chars(word).length <= 64 && !/[0-9_/@#\\]/u.test(word)) customWords.add(word);
      }
    }
    return customWords.size;
  }

  function addCustomWord(rawWord) {
    const word = normalize(rawWord);
    if (!word || chars(word).length < 2 || chars(word).length > 64 || /[0-9_/@#\\]/u.test(word)) return false;
    customWords.add(word);
    return true;
  }

  function removeCustomWord(rawWord) {
    return customWords.delete(normalize(rawWord));
  }

  function getCustomWords() {
    return Array.from(customWords).sort((a,b) => a.localeCompare(b, 'tr-TR'));
  }

  const customProperNames = new Map();

  function setCustomProperNames(words) {
    customProperNames.clear();
    if (Array.isArray(words) || words instanceof Set) {
      for (const raw of words) {
        const canonical = String(raw || '').trim();
        const key = normalize(canonical);
        if (key && chars(key).length >= 2 && chars(key).length <= 64 && !/[0-9_/@#\\]/u.test(key)) customProperNames.set(key, canonical);
      }
    }
    return customProperNames.size;
  }

  function getCustomProperNames() {
    return Array.from(customProperNames.values()).sort((a,b) => a.localeCompare(b, 'tr-TR'));
  }

  const LOCAL_TECH_WORDS = new Set([
    'xenforo','minecraft','discord','warext','mc-tr','php','javascript','typescript','css','html',
    'json','xml','mysql','mariadb','linux','windows','android','ios','github','gitlab','docker','api',
    'frontend','backend','webhook','plugin','eklenti','modpack','resourcepack','texturepack'
  ]);
  for (const word of LOCAL_TECH_WORDS) valid.add(word);

  const byFirstLength = new Map();
  const byLength = new Map();
  const lengthOf = word => chars(word).length;
  for (const word of tdkWords) {
    const c = chars(word);
    if (!c.length) continue;
    const len = c.length;
    const key = `${c[0]}:${len}`;
    if (!byFirstLength.has(key)) byFirstLength.set(key, []);
    byFirstLength.get(key).push(word);
    if (!byLength.has(len)) byLength.set(len, []);
    byLength.get(len).push(word);
  }

  const SUFFIXES = [
    'lerimizden','larımızdan','lerinizden','larınızdan','lerimiz','larımız','leriniz','larınız',
    'umuzdan','ümüzden','ımızdan','imizden','unuzdan','ünüzden','ınızdan','inizden',
    'umuzda','ümüzde','ımızda','imizde','unuzda','ünüzde','ınızda','inizde',
    'umuz','ümüz','ımız','imiz','unuz','ünüz','ınız','iniz',
    'ları','leri','lar','ler','dan','den','tan','ten','dır','dir','dur','dür','tır','tir','tur','tür',
    'lık','lik','luk','lük','cı','ci','cu','cü','çı','çi','çu','çü','sız','siz','suz','süz',
    'ım','im','um','üm','ın','in','un','ün','da','de','ta','te','ya','ye','yı','yi','yu','yü',
    'la','le','lı','li','lu','lü'
  ].sort((a,b) => chars(b).length - chars(a).length);

  function isLikelyInflected(word) {
    if (!word || COMMON[word]) return false;
    if (valid.has(word)) return true;
    const morphology = analyzeMorphology(word);
    return !!morphology.valid;
  }

  function damerau(a, b, maxDistance = 3) {
    const A = chars(a), B = chars(b);
    const n = A.length, m = B.length;
    if (Math.abs(n - m) > maxDistance) return maxDistance + 1;
    let prev2 = null;
